generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  role        Role     @default(VICTIM)
  fullName    String
  icNumber    String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cases       Case[]
}

model Case {
  id               String           @id @default(cuid())
  rawDescription   String
  detectedLanguage String?
  scamType         String?
  amountLost       Float?
  urgency          String?
  priority         String           @default("NORMAL")
  summary          String?
  missingInfo      Json?
  suggestedStep    String?
  suggestedRouting String?
  assignedAgency   String?
  authorityNotes   String?          @default("")
  documents        Json?
  workflowStatus   String           @default("NEW")
  recoverabilityScore Int?
  recoverabilityLevel String?
  timeToActMinutes    Int?
  priorityReason      Json?
  interventionOutcome String?
  interventionAction  String?
  interventionTimeMins Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userId           String
  ticket           AuthorityTicket?
  user             User             @relation(fields: [userId], references: [id])
  evidence         Evidence[]
  followUpTasks    FollowUpTask[]
  messages         Message[]
  workflowLogs     WorkflowLog[]
}

model FollowUpTask {
  id          String    @id @default(cuid())
  caseId      String
  title       String
  description String
  assignedTo  String?
  dueAt       DateTime?
  dedupeKey   String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  case        Case      @relation(fields: [caseId], references: [id])

  @@unique([caseId, dedupeKey])
}

model WorkflowLog {
  id        String   @id @default(cuid())
  caseId    String
  eventType String
  message   String
  actorType String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id])
}

model AuthorityTicket {
  id             String   @id @default(cuid())
  caseId         String   @unique
  priority       String   @default("NORMAL")
  assignedAgency String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  case           Case     @relation(fields: [caseId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  caseId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      Case     @relation(fields: [caseId], references: [id])
}

model Evidence {
  id        String   @id @default(cuid())
  caseId    String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  case      Case     @relation(fields: [caseId], references: [id])
}

enum Role {
  VICTIM
  AUTHORITY
}
